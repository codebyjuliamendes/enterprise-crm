# Copy to .env and adjust. Never commit the real .env.

# development | test | production
NODE_ENV=development
PORT=3004
HOST=0.0.0.0

# SQLite file (created on first boot). Use :memory: for a throwaway database.
DB_PATH=data/crm.db

# Required when NODE_ENV=production, at least 32 characters: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Seed four demo accounts sharing the public password "admin123" when the database is empty.
# Defaults to true outside production and false in production.
SEED_DEMO_DATA=

# Optional: create this admin account on boot if it does not exist (password >= 12 chars).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: comma-separated origins allowed to call the API cross-origin (default: none).
CORS_ORIGIN=

# Set when running behind a reverse proxy / ingress so rate limits see the client IP (e.g. 1).
TRUST_PROXY=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
