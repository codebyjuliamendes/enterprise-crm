{
  "name": "enterprise-crm",
  "version": "1.0.0",
  "description": "Mini CRM with role-based access, deal pipeline, audit trail and LGPD anonymization (Node.js, Express, SQLite via sql.js)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "user:set-password": "node scripts/set-password.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sql.js": "^1.15.2",
    "swagger-ui-dist": "^5.34.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "license": "MIT",
  "private": true
}
